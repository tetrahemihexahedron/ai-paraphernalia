{
  "name": "blossom-research",
  "image": "mcr.microsoft.com/devcontainers/base:debian",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "username": "dev",
      "userUid": "1001",
      "userGid": "1001"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.19.0",
      "pnpmVersion": "11.23"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  "remoteUser": "dev",
  "workspaceFolder": "/workspaces/blossom-research",

  "containerEnv": {
    "PI_CODING_AGENT_DIR": "/workspaces/blossom-research/.pi",
    "PLAYWRIGHT_BROWSERS_PATH": "/workspaces/blossom-research/.pi/cache/ms-playwright",
    "PLAYWRIGHT_MCP_CONFIG": "/workspaces/blossom-research/.playwright/cli.config.json"
  },

  "postCreateCommand": "bash .devcontainer/setup-tools.sh"
}
